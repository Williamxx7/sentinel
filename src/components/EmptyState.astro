---
interface Props {
	title: string;
	text: string;
}
const { title, text } = Astro.props;
---

<div class="flex flex-col items-center justify-center rounded-md border border-dashed border-line px-6 py-14 text-center">
	<svg
		viewBox="0 0 24 24"
		class="mb-3 h-12 w-12 text-ink-muted"
		fill="none"
		stroke="currentColor"
		stroke-width="1.2"
		stroke-linecap="round"
		stroke-linejoin="round"
	>
		<path d="M3 7h18v13H3V7Zm0 4h18M8 7V4h8v3" />
	</svg>
	<h3 class="text-sm font-semibold text-ink">{title}</h3>
	<p class="mt-1 max-w-sm text-sm text-ink-soft">{text}</p>
	<div class="mt-4">
		<slot />
	</div>
</div>
