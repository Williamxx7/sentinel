---
import Shell from '../layouts/Shell.astro';
import Panel from '../components/Panel.astro';
import StatusBadge from '../components/StatusBadge.astro';
import EmptyState from '../components/EmptyState.astro';
import { daysUntil, listAssets } from '../server/repo';

export const prerender = false;

const assets = await listAssets();

const TYPE_LABEL: Record<string, string> = {
	domain: 'Domæne',
	api: 'API',
	key: 'Nøgle',
	certificate: 'Certifikat',
	other: 'Andet',
};

const error = Astro.url.searchParams.get('error');

function dateInput(iso: string | null): string {
	return iso ? iso.slice(0, 10) : '';
}
---

<Shell title="Aktiver" active="assets">
	<Panel title="Register" subtitle={`${assets.length} aktiver · domæner, API'er, nøgler og certifikater`}>
		<Fragment slot="actions">
			<details class="relative">
				<summary class="btn btn-primary cursor-pointer list-none">Tilføj aktiv</summary>
				<form method="post" action="/api/assets" class="mt-3 grid w-[min(90vw,420px)] gap-3 rounded-md border border-line bg-elevated p-4">
					<div>
						<label class="mb-1 block text-xs text-ink-soft" for="a-name">Navn</label>
						<input id="a-name" name="name" required class="field" placeholder="Primært domæne" />
					</div>
					<div class="grid grid-cols-2 gap-3">
						<div>
							<label class="mb-1 block text-xs text-ink-soft" for="a-type">Type</label>
							<select id="a-type" name="type" class="field">
								{Object.entries(TYPE_LABEL).map(([v, l]) => <option value={v}>{l}</option>)}
							</select>
						</div>
						<div>
							<label class="mb-1 block text-xs text-ink-soft" for="a-exp">Udløber</label>
							<input id="a-exp" name="expiresAt" type="date" class="field" />
						</div>
					</div>
					<div>
						<label class="mb-1 block text-xs text-ink-soft" for="a-id">Identifikator</label>
						<input id="a-id" name="identifier" required class="field" placeholder="example.dk" />
					</div>
					<div>
						<label class="mb-1 block text-xs text-ink-soft" for="a-tags">Tags (kommasepareret)</label>
						<input id="a-tags" name="tags" class="field" placeholder="prod, kritisk" />
					</div>
					<div>
						<label class="mb-1 block text-xs text-ink-soft" for="a-notes">Noter</label>
						<textarea id="a-notes" name="notes" rows="2" class="field"></textarea>
					</div>
					<button type="submit" class="btn btn-primary">Gem aktiv</button>
					{error === 'date' && <p class="text-xs text-danger">Ugyldig dato.</p>}
					{error === 'missing' && <p class="text-xs text-danger">Navn og identifikator er påkrævet.</p>}
				</form>
			</details>
		</Fragment>

		{assets.length === 0 ? (
			<EmptyState title="Ingen aktiver registreret" text="Tilføj domæner, API-nøgler og certifikater for at holde styr på udløbsdatoer." />
		) : (
			<div class="overflow-x-auto rounded-sm border border-line">
				<table class="w-full text-sm">
					<thead>
						<tr class="bg-elevated text-left text-[11px] uppercase tracking-wide text-ink-muted">
							<th class="px-4 py-2 font-medium">Navn</th>
							<th class="px-4 py-2 font-medium">Type</th>
							<th class="px-4 py-2 font-medium">Identifikator</th>
							<th class="px-4 py-2 font-medium">Udløb</th>
							<th class="px-4 py-2 font-medium">Tags</th>
							<th class="px-4 py-2"></th>
						</tr>
					</thead>
					<tbody>
						{assets.map((a) => {
							const d = daysUntil(a.expiresAt);
							return (
								<Fragment>
									<tr class="border-t border-line hover:bg-canvas">
										<td class="px-4 py-2.5 text-ink">{a.name}</td>
										<td class="px-4 py-2.5 text-ink-soft">{TYPE_LABEL[a.type]}</td>
										<td class="px-4 py-2.5 font-mono text-xs text-ink-soft">{a.identifier}</td>
										<td class="px-4 py-2.5">
											{d === null ? (
												<span class="text-ink-muted">—</span>
											) : (
												<StatusBadge
													tone={d < 0 ? 'danger' : d <= 30 ? 'warn' : 'success'}
													label={d < 0 ? 'udløbet' : `${d} dage`}
													dot={false}
												/>
											)}
										</td>
										<td class="px-4 py-2.5">
											<div class="flex flex-wrap gap-1">
												{a.tags.map((t) => (
													<span class="rounded-full border border-line px-2 py-0.5 text-[11px] text-ink-muted">{t}</span>
												))}
											</div>
										</td>
										<td class="px-4 py-2.5 text-right">
											<div class="flex items-center justify-end gap-2">
												<button type="button" data-edit={a.id} class="btn btn-secondary h-7 px-2 text-xs">
													Rediger
												</button>
												<form method="post" action="/api/assets/delete">
													<input type="hidden" name="id" value={a.id} />
													<button class="btn btn-danger h-7 px-2 text-xs">Slet</button>
												</form>
											</div>
										</td>
									</tr>
									<tr id={`edit-${a.id}`} class="hidden border-t border-line bg-canvas">
										<td colspan="6" class="px-4 py-4">
											<form method="post" action="/api/assets/update" class="grid gap-3 md:grid-cols-2">
												<input type="hidden" name="id" value={a.id} />
												<div>
													<label class="mb-1 block text-xs text-ink-soft">Navn</label>
													<input name="name" required value={a.name} class="field" />
												</div>
												<div>
													<label class="mb-1 block text-xs text-ink-soft">Identifikator</label>
													<input name="identifier" required value={a.identifier} class="field" />
												</div>
												<div class="grid grid-cols-2 gap-3">
													<div>
														<label class="mb-1 block text-xs text-ink-soft">Type</label>
														<select name="type" class="field">
															{Object.entries(TYPE_LABEL).map(([v, l]) => (
																<option value={v} selected={v === a.type}>{l}</option>
															))}
														</select>
													</div>
													<div>
														<label class="mb-1 block text-xs text-ink-soft">Udløber</label>
														<input name="expiresAt" type="date" value={dateInput(a.expiresAt)} class="field" />
													</div>
												</div>
												<div>
													<label class="mb-1 block text-xs text-ink-soft">Tags (kommasepareret)</label>
													<input name="tags" value={a.tags.join(', ')} class="field" />
												</div>
												<div class="md:col-span-2">
													<label class="mb-1 block text-xs text-ink-soft">Noter</label>
													<textarea name="notes" rows="2" class="field">{a.notes}</textarea>
												</div>
												<div class="flex items-center gap-2 md:col-span-2">
													<button type="submit" class="btn btn-primary">Gem ændringer</button>
													<button type="button" data-cancel={a.id} class="btn btn-secondary">Annuller</button>
												</div>
											</form>
										</td>
									</tr>
								</Fragment>
							);
						})}
					</tbody>
				</table>
			</div>
		)}
	</Panel>
</Shell>

<script>
	function toggleEdit(id: string, show: boolean) {
		document.getElementById(`edit-${id}`)?.classList.toggle('hidden', !show);
	}
	document.querySelectorAll<HTMLElement>('[data-edit]').forEach((btn) => {
		btn.addEventListener('click', () => toggleEdit(btn.dataset.edit!, true));
	});
	document.querySelectorAll<HTMLElement>('[data-cancel]').forEach((btn) => {
		btn.addEventListener('click', () => toggleEdit(btn.dataset.cancel!, false));
	});
</script>
