---
import Shell from '../layouts/Shell.astro';
import Panel from '../components/Panel.astro';
import StatusBadge from '../components/StatusBadge.astro';
import EmptyState from '../components/EmptyState.astro';
import { listVulnerabilities } from '../server/repo';

export const prerender = false;

const all = await listVulnerabilities();
const statusFilter = Astro.url.searchParams.get('status') ?? '';
const vulns = statusFilter ? all.filter((v) => v.status === statusFilter) : all;
const open = all.filter((v) => v.status === 'open').length;
const urgent = all.filter(
	(v) => v.status === 'open' && (v.severity === 'high' || v.severity === 'critical'),
).length;

const SEVERITY_TONE: Record<string, 'danger' | 'warn' | 'muted'> = {
	critical: 'danger',
	high: 'danger',
	medium: 'warn',
	low: 'muted',
};
const SEVERITY_LABEL: Record<string, string> = {
	critical: 'Kritisk',
	high: 'Høj',
	medium: 'Mellem',
	low: 'Lav',
};
const STATUS_LABEL: Record<string, string> = {
	open: 'Åben',
	accepted: 'Accepteret',
	resolved: 'Løst',
};
const STATUS_TONE: Record<string, 'danger' | 'warn' | 'muted' | 'success'> = {
	open: 'warn',
	accepted: 'muted',
	resolved: 'success',
};
---

<Shell title="Sårbarheder" active="vulns">
	<div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
		<div class="rounded-md border border-line bg-surface p-5">
			<p class="text-[11px] font-medium uppercase tracking-wide text-ink-muted">Fund i alt</p>
			<p class="mt-1 font-mono text-[28px] font-semibold leading-none text-ink">{all.length}</p>
		</div>
		<div class="rounded-md border border-line bg-surface p-5">
			<p class="text-[11px] font-medium uppercase tracking-wide text-ink-muted">Åbne</p>
			<p class="mt-1 font-mono text-[28px] font-semibold leading-none" style={open > 0 ? 'color:#fbbf24' : ''}>{open}</p>
		</div>
		<div class="rounded-md border border-line bg-surface p-5">
			<p class="text-[11px] font-medium uppercase tracking-wide text-ink-muted">Høj/kritisk</p>
			<p class="mt-1 font-mono text-[28px] font-semibold leading-none" style={urgent > 0 ? 'color:#f87171' : ''}>{urgent}</p>
		</div>
		<div class="rounded-md border border-line bg-surface p-5">
			<p class="text-[11px] font-medium uppercase tracking-wide text-ink-muted">Accepteret</p>
			<p class="mt-1 font-mono text-[28px] font-semibold leading-none text-ink">{all.filter((v) => v.status === 'accepted').length}</p>
		</div>
	</div>

	<div class="mt-6">
		<Panel
			title="Sikkerhedsfund"
			subtitle="Fra den ugentlige nmap-scan. Accepter kendte fund, så de ikke støjer."
		>
			<form method="get" class="mb-4 flex flex-wrap items-end gap-2">
				<div>
					<label class="mb-1 block text-xs text-ink-soft" for="status">Status</label>
					<select id="status" name="status" class="field">
						<option value="">Alle</option>
						<option value="open" selected={statusFilter === 'open'}>Åben</option>
						<option value="accepted" selected={statusFilter === 'accepted'}>Accepteret</option>
						<option value="resolved" selected={statusFilter === 'resolved'}>Løst</option>
					</select>
				</div>
				<button class="btn btn-secondary">Filtrer</button>
				{statusFilter && <a href="/vulnerabilities" class="btn btn-secondary">Nulstil</a>}
			</form>

			{vulns.length === 0 ? (
				<EmptyState
					title="Ingen fund"
					text="Der er ingen fund endnu. Den ugentlige sårbarhedsscan opretter dem automatisk, når den er sat op."
				/>
			) : (
				<div class="space-y-3">
					{vulns.map((v) => (
						<div class="rounded-sm border border-line p-4">
							<div class="flex flex-wrap items-start justify-between gap-3">
								<div class="min-w-0">
									<div class="flex flex-wrap items-center gap-2">
										<span class="text-sm font-medium text-ink">{v.title}</span>
										<StatusBadge tone={SEVERITY_TONE[v.severity]} label={SEVERITY_LABEL[v.severity]} dot={false} />
										<StatusBadge tone={STATUS_TONE[v.status]} label={STATUS_LABEL[v.status]} />
									</div>
									<p class="mt-0.5 font-mono text-xs text-ink-muted">
										{v.script} · {v.ip ?? v.mac} · sidst set {new Date(v.lastSeen).toLocaleString('da-DK')}
									</p>
									{v.detail && (
										<details class="mt-2">
											<summary class="cursor-pointer text-xs text-ink-soft">Detaljer</summary>
											<pre class="mt-1 whitespace-pre-wrap break-words font-mono text-[11px] text-ink-muted">{v.detail}</pre>
										</details>
									)}
								</div>
								<div class="flex items-center gap-2">
									{v.status === 'open' ? (
										<>
											<form method="post" action="/api/vulnerabilities/update">
												<input type="hidden" name="id" value={v.id} />
												<input type="hidden" name="status" value="accepted" />
												<button class="btn btn-secondary h-7 px-2 text-xs">Accepter</button>
											</form>
											<form method="post" action="/api/vulnerabilities/update">
												<input type="hidden" name="id" value={v.id} />
												<input type="hidden" name="status" value="resolved" />
												<button class="btn btn-secondary h-7 px-2 text-xs">Løs</button>
											</form>
										</>
									) : (
										<form method="post" action="/api/vulnerabilities/update">
											<input type="hidden" name="id" value={v.id} />
											<input type="hidden" name="status" value="open" />
											<button class="btn btn-secondary h-7 px-2 text-xs">Genåbn</button>
										</form>
									)}
									<form method="post" action="/api/vulnerabilities/delete">
										<input type="hidden" name="id" value={v.id} />
										<button class="btn btn-danger h-7 px-2 text-xs">Slet</button>
									</form>
								</div>
							</div>
						</div>
					))}
				</div>
			)}
		</Panel>
	</div>
</Shell>
